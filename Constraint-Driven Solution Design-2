import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s = sc.next();

            int n = s.length();
            int[] left = new int[26];
            int[] right = new int[26];

            for (int i = 0; i < n / 2; i++) {
                left[s.charAt(i) - 'a']++;
                right[s.charAt(n - 1 - i) - 'a']++;
            }

            boolean lapindrome = true;

            for (int i = 0; i < 26; i++) {
                if (left[i] != right[i]) {
                    lapindrome = false;
                    break;
                }
            }

            System.out.println(lapindrome ? "YES" : "NO");
        }

        sc.close();
    }
}
